# AWS Emulator in a container, from AWS's Dockerfile (Getting started with Docker), except that the
# package comes from the build context: start.sh downloads it and checks AWS's signature first.
FROM public.ecr.aws/amazonlinux/amazonlinux:2023-minimal
COPY aws-emulator-x86_64.rpm /tmp/aws-emulator.rpm
RUN rpm -i /tmp/aws-emulator.rpm && rm /tmp/aws-emulator.rpm \
    && mkdir -p /home/emulator && chown 1000 /home/emulator
USER 1000
ENV HOME=/home/emulator
EXPOSE 9297
ENTRYPOINT ["aws-emulator", "-b", "0.0.0.0"]
