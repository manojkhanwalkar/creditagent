# Copy to .env (git-ignored) and fill in. Never commit real values.

# Shared by the report generator and the MCP server. At least 32 characters.
# Generate one with: openssl rand -hex 32
CREDIT_FILE_HMAC_KEY=

# Demo data: synthetic reports are generated for these SSNs at start-up.
# Use made-up numbers only.
CREDIT_SEED_SSNS=123-45-6789,234-56-7890,345-67-8901

# Optional: LLM-written recommendations in the Credit Intelligence Agent.
LLM_ENABLED=false
ANTHROPIC_API_KEY=
