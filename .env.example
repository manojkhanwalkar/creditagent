# Copy to .env (git-ignored) and fill in. Never commit real values.

# Shared by the report generator and the MCP server. At least 32 characters.
# Generate one with: openssl rand -hex 32
CREDIT_FILE_HMAC_KEY=

# Signs the login JWTs issued by the web server. At least 32 characters.
# Generate one with: openssl rand -hex 32
JWT_SECRET=

# Keyed hash of each user's SSN in the users table. At least 32 characters, and different from
# the keys above. Changing it orphans every registered SSN. Generate one with: openssl rand -hex 32
SSN_HMAC_KEY=

# Shared token the agent and the MCP server present to the web server's internal API to check
# whether a consumer has locked their credit report. At least 32 characters, different from the
# keys above. Without it, third-party report pulls are refused. Generate one with: openssl rand -hex 32
INTERNAL_API_TOKEN=

# Claude connector (claude-connector). Key for the web server's OAuth tokens: at least 32 characters,
# different from the keys above. Empty turns the connector's sign-in off. openssl rand -hex 32
OAUTH_TOKEN_KEY=
# Public URLs, exactly as Claude and browsers reach them. Claude connects from the internet, so for
# claude.ai these must be public HTTPS URLs (a tunnel or reverse proxy); localhost works for Claude Code.
OAUTH_ISSUER=http://localhost:8080
CONNECTOR_PUBLIC_URL=http://localhost:8088

# Dark-web monitor (placeholder source, contacts nothing). Emails listed here, comma-separated, are
# always reported as found, so the login alert can be demonstrated. Leave empty otherwise. No other
# exposures are invented unless DARKWEB_PLACEHOLDER_RATE (0 to 1, default 0) is set.
DARKWEB_PLACEHOLDER_EXPOSED=

# Alert emails (alert-notifier). Compose sends them to Mailpit (http://localhost:8025) unless MAIL_HOST
# names a real SMTP relay; then also set the rest, with STARTTLS and auth on (the notifier refuses to
# start with STARTTLS off for a relay that is not local).
MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_SMTP_AUTH=true
# MAIL_STARTTLS=true
NOTIFIER_APP_URL=http://localhost:8080

# Demo data: synthetic reports are generated for these SSNs at start-up.
# Use made-up numbers only.
CREDIT_SEED_SSNS=123-45-6789,234-56-7890,345-67-8901

# Optional: LLM-written recommendations in the Credit Intelligence Agent.
LLM_ENABLED=false
ANTHROPIC_API_KEY=
